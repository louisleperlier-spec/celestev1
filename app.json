{
  "expo": {
    "name": "NÉA",
    "slug": "nea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nea",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.neacoach.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070708",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070708",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NÉA utilise ta position pendant tes sorties vélo pour tracer ton parcours et calculer ta distance et ta vitesse."
        }
      ],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "NÉA lit ton sommeil, ta VFC, ta fréquence cardiaque au repos et ton poids dans Apple Santé pour calculer ton score de récupération et adapter tes séances.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#070708",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8236e0bd-7d60-4537-9cbb-6df1ea24586a"
      }
    },
    "owner": "leaderprinces-team",
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/8236e0bd-7d60-4537-9cbb-6df1ea24586a"
    }
  }
}

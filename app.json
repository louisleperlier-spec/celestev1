{
  "expo": {
    "name": "SelfMax",
    "slug": "selfmax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "selfmax",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.selfmax.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.selfmax.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SelfMax utilise tes photos pour suivre visuellement tes progrès physiques, uniquement sur cet appareil.",
          "cameraPermission": "SelfMax utilise l'appareil photo pour prendre une photo de progression, uniquement sur cet appareil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
